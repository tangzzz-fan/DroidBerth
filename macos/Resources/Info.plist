<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>icon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 zhenzhi Tang</string>
	<!-- 出口合规（Export Compliance）。`false` = **不使用非豁免加密**。
	     本 app 的通信只有 USB / 局域网 TCP 上的 adb 协议（明文），且**没有** HTTP 客户端
	     ⇒ 连「标准 HTTPS」这一类豁免加密都不涉及，所以只有这一条。
	     ⚠️ 缺了它，App Store Connect 会在每个上传的构建版本上标「缺少合规证明」并要求人工回答，
	     而且**每次上传都要重答一遍**（2026-10-13 实测遇到）。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DroidBerth 需要读取照片与视频的原始文件，才能把它们推送到你的 Android 设备。</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>DroidBerth 需要访问桌面，以便浏览和传输桌面上的文件。</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>DroidBerth 需要访问文稿文件夹，以便浏览和传输其中的文件。</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>DroidBerth 需要访问下载文件夹，以便浏览和传输其中的文件。</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>DroidBerth 需要访问可移动卷，以便浏览和传输外接存储上的文件。</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.tango.droidberth.transfer</string>
			<key>UTTypeDescription</key>
			<string>DroidBerth 拖拽载荷</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>发送到 DroidBerth</string>
			</dict>
			<key>NSMessage</key>
			<string>sendToDevice</string>
			<key>NSPortName</key>
			<string>DroidBerth</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSRestricted</key>
			<false/>
			<key>NSServiceDescription</key>
			<string>把 Finder 中选中的文件或文件夹推送到已连接的 Android 设备</string>
		</dict>
	</array>
</dict>
</plist>
