{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroidBerth",
  "version": "0.1.0",
  "identifier": "dev.tango.droidberth",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DroidBerth - Tauri + ADB Sidecar Risk Validation",
        "width": 1280,
        "height": 880,
        "minWidth": 980,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Tauri + ADB sidecar notarization and wireless-debug validation demo",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/droidberth-adb"],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
